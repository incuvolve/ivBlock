      <PreActions>
         <ExecutionAction
            ActionType = "Xcode.IDEStandardExecutionActionsCore.ExecutionActionType.ShellScriptAction">
            <ActionContent
               title = "Set Simulator Language to German"
               scriptText = "&#10;LOGFILE=&quot;/Users/micha/Development/xcode.log&quot;&#10;LANG=&quot;German&quot;&#10;APPLANG=&quot;de&quot;&#10;APPLOCALE=&quot;de_DE&quot;&#10;&#10;&#10;exec &gt; $LOGFILE 2&gt;&amp;1&#10;&#10;SIMCTL=&quot;/Applications/Xcode.app/Contents/Developer/usr/bin/simctl&quot;&#10;&#10;# Prefer the Simulator selected by Xcode.&#10;UDID=&quot;${TARGET_DEVICE_IDENTIFIER:-${SIMULATOR_UDID:-}}&quot;&#10;&#10;# Fallback: use the first currently booted Simulator.&#10;if [ -z &quot;$UDID&quot; ]; then&#10;    UDID=&quot;$(&quot;$SIMCTL&quot; list devices booted | awk -F &apos;[()]&apos; &apos;/Booted/{print $2; exit}&apos;)&quot;&#10;fi&#10;&#10;if [ -z &quot;$UDID&quot; ]; then&#10;    echo &quot;No simulator UDID resolved; skipping locale pre-action.&quot;&#10;    exit 0&#10;fi&#10;&#10;echo &quot;Using Simulator: $UDID&quot;&#10;&#10;# Path to the Simulator&apos;s global preferences.&#10;PLIST=&quot;$HOME/Library/Developer/CoreSimulator/Devices/$UDID/data/Library/Preferences/.GlobalPreferences.plist&quot;&#10;&#10;if [ ! -f &quot;$PLIST&quot; ]; then&#10;    echo &quot;Global preferences file not found:&quot;&#10;    echo &quot;$PLIST&quot;&#10;    exit 1&#10;fi&#10;&#10;# Stop the Simulator before modifying its preferences.&#10;echo &quot;Shutting down Simulator...&quot;&#10;&quot;$SIMCTL&quot; shutdown &quot;$UDID&quot; &gt;/dev/null 2&gt;&amp;1 || true&#10;&#10;sleep 2&#10;&#10;# Configure language.&#10;echo &quot;Setting language to &quot;$LANG&quot;...&quot;&#10;/usr/libexec/PlistBuddy -c &quot;Delete :AppleLanguages&quot; &quot;$PLIST&quot; 2&gt;/dev/null || true&#10;/usr/libexec/PlistBuddy -c &quot;Add :AppleLanguages array&quot; &quot;$PLIST&quot;&#10;/usr/libexec/PlistBuddy -c &quot;Add :AppleLanguages:0 string $APPLANG&quot; &quot;$PLIST&quot;&#10;&#10;# Configure locale.&#10;/usr/libexec/PlistBuddy -c &quot;Set :AppleLocale $APPLOCALE&quot; &quot;$PLIST&quot; 2&gt;/dev/null || \&#10;/usr/libexec/PlistBuddy -c &quot;Add :AppleLocale string $APPLOCALE&quot; &quot;$PLIST&quot;&#10;&#10;echo &quot;Simulator configured for &quot;$LANG&quot; (&quot;$APPLOCALE&quot;): $UDID&quot;&#10;"
               shellToInvoke = "/bin/sh">
            </ActionContent>
         </ExecutionAction>
      </PreActions>
