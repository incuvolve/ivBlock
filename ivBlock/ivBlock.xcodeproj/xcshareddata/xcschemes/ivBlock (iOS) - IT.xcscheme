               scriptText = "SIMCTL=/Applications/Xcode.app/Contents/Developer/usr/bin/simctl&#10;UDID=D74EB2E1-8D1B-4C86-BFE7-18B13770FC9C&#10;PLIST=&quot;$HOME/Library/Developer/CoreSimulator/Devices/$UDID/data/Library/Preferences/.GlobalPreferences.plist&quot;&#10;$SIMCTL shutdown $UDID 2&gt;/dev/null&#10;sleep 2&#10;/usr/libexec/PlistBuddy -c &quot;Delete :AppleLanguages&quot; &quot;$PLIST&quot; 2&gt;/dev/null&#10;/usr/libexec/PlistBuddy -c &quot;Add :AppleLanguages array&quot; &quot;$PLIST&quot;&#10;/usr/libexec/PlistBuddy -c &quot;Add :AppleLanguages:0 string it-IT&quot; &quot;$PLIST&quot;&#10;/usr/libexec/PlistBuddy -c &quot;Set :AppleLocale it_IT&quot; &quot;$PLIST&quot; 2&gt;/dev/null || /usr/libexec/PlistBuddy -c &quot;Add :AppleLocale string it_IT&quot; &quot;$PLIST&quot;&#10;"
               shellToInvoke = "/bin/sh">
            </ActionContent>
         </ExecutionAction>
      </PreActions>
